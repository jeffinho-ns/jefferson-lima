# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contato (exibidos publicamente) ---
NEXT_PUBLIC_EMAIL=
# Somente dígitos com DDI, ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP=

# --- Redes sociais (deixe vazio para ocultar) ---
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Formulário de contato (somente servidor) ---
RESEND_API_KEY=
# Destinatário das mensagens do formulário
CONTACT_TO_EMAIL=
# Remetente verificado no Resend (ex.: "Site <contato@seudominio.com>")
CONTACT_FROM_EMAIL=

# --- Rate limit do formulário ---
# Máximo de envios por janela, por IP
RATE_LIMIT=5
# Janela em segundos
RATE_LIMIT_WINDOW_SECONDS=600

# --- Analytics (só usado se features.analyticsEnabled = true) ---
NEXT_PUBLIC_ANALYTICS_ID=
